// ui/app_launcher.slint
import { ScrollView } from "std-widgets.slint";

component StyledButton inherits Rectangle {
    in-out property <string> text;
    in-out property <color> text-color: #ffffff;
    callback clicked;

    min-width: 80px;
    min-height: 30px;
    border-radius: 4px;

    HorizontalLayout {
        padding-left: 14px;
        padding-right: 14px;
        padding-top: 4px;
        padding-bottom: 4px;
        Text {
            text: root.text;
            color: root.text-color;
            font-size: 12px;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }

    TouchArea {
        clicked => { root.clicked(); }
    }
}

export struct AppItem {
    name: string,
    path: string,
}

export component MainWindow inherits Window {
    preferred-width: 550px;
    preferred-height: 450px;
    min-width: 400px;
    min-height: 300px;
    title: "Game Launcher";
    background: #f7fafc;

    callback launch_app(string);
    callback add_app_clicked();
    callback delete_app(int);

    in-out property <[AppItem]> apps: [];
    in-out property <int> app_name_font_size: 14;
    in-out property <int> app_path_font_size: 11;

    // ショートカット入力を受け取るためのフォーカススコープ
    FocusScope {
        VerticalLayout {
            padding: 20px;
            spacing: 15px;

            Text {
                text: "ゲームランチャー";
                font-size: 22px;
                font-weight: 700;
                horizontal-alignment: center;
                color: #2d3748;
            }

            ScrollView {
                vertical-stretch: 1;
                VerticalLayout {
                    alignment: start;
                    spacing: 10px;
                    for app[idx] in root.apps : Rectangle {
                        background: #ffffff;
                        border-radius: 8px;
                        border-width: 1px;
                        border-color: #e2e8f0;
                        height: 60px;

                        HorizontalLayout {
                            padding-left: 15px;
                            padding-right: 15px;
                            spacing: 12px;

                            VerticalLayout {
                                alignment: center;
                                spacing: 2px;
                                Text {
                                    text: app.name;
                                    font-size: root.app_name_font_size * 1px;
                                    font-weight: 600;
                                    color: #1a202c;
                                }
                                Text {
                                    text: app.path;
                                    font-size: root.app_path_font_size * 1px;
                                    color: #718096;
                                    overflow: elide;
                                }
                            }

                            // スペーサー（右寄せ用）
                            Rectangle {}

                            HorizontalLayout {
                                alignment: center;
                                spacing: 8px;
                                StyledButton {
                                    text: "起動";
                                    background: #3182ce;
                                    clicked => {
                                        root.launch_app(app.path);
                                    }
                                }
                                StyledButton {
                                    text: "削除";
                                    background: #e53e3e;
                                    clicked => {
                                        root.delete_app(idx);
                                    }
                                }
                            }
                        }
                    }
                }
            }

            StyledButton {
                text: "+ アプリケーションを追加";
                background: #38a169;
                clicked => {
                    root.add_app_clicked();
                }
            }
        }
    }
}
