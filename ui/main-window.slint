// ui/app_launcher.slint
import { ScrollView } from "std-widgets.slint";

component StyledButton inherits Rectangle {
    in-out property <string> text;
    in-out property <color> text-color: #ffffff;
    in-out property <color> button-color: #3182ce;
    callback clicked;

    min-width: 80px;
    min-height: 30px;
    border-radius: 4px;

    ta := TouchArea {
        clicked => { root.clicked(); }
    }

    background: ta.pressed ? root.button-color.darker(0.2) : ta.has-hover ? root.button-color.brighter(0.15) : root.button-color;

    HorizontalLayout {
        padding-left: 14px;
        padding-right: 14px;
        padding-top: 4px;
        padding-bottom: 4px;
        Text {
            text: root.text;
            color: root.text-color;
            font-size: 12px;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }
}

export struct AppItem {
    name: string,
    path: string,
}

export component MainWindow inherits Window {
    preferred-width: 550px;
    preferred-height: 450px;
    min-width: 400px;
    min-height: 300px;
    title: "Game Launcher";
    background: #f7fafc;

    callback launch_app(string);
    callback add_app_clicked();
    callback delete_app(int);

    in-out property <[AppItem]> apps: [];
    in-out property <int> app_name_font_size: 14;
    in-out property <int> app_path_font_size: 11;
    in-out property <bool> show_edit_buttons: true;
    in-out property <string> toast-text: "";
    callback toast-close();

    FocusScope {
        VerticalLayout {
            padding: 20px;
            spacing: 15px;

            HorizontalLayout {
                Rectangle { horizontal-stretch: 1; }
                Text {
                    text: "ゲームランチャー";
                    font-size: 22px;
                    font-weight: 700;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                    color: #2d3748;
                }
                Rectangle { horizontal-stretch: 1; }
            }

            ScrollView {
                vertical-stretch: 1;
                VerticalLayout {
                    alignment: start;
                    spacing: 10px;
                    for app[idx] in root.apps : Rectangle {
                        border-radius: 8px;
                        border-width: 1px;
                        height: 60px;

                        ta := TouchArea {
                            clicked => { root.launch_app(app.path); }
                        }

                        background: ta.pressed ? #e2e8f0 : ta.has-hover ? #f0f4f8 : #ffffff;
                        border-color: ta.has-hover ? #cbd5e1 : #e2e8f0;

                        HorizontalLayout {
                            padding-left: 15px;
                            padding-right: 15px;
                            spacing: 12px;

                            VerticalLayout {
                                alignment: center;
                                spacing: 2px;
                                Text {
                                    text: app.name;
                                    font-size: root.app_name_font_size * 1px;
                                    font-weight: 600;
                                    color: #1a202c;
                                }
                                Text {
                                    text: app.path;
                                    font-size: root.app_path_font_size * 1px;
                                    color: #718096;
                                    overflow: elide;
                                }
                            }

                            Rectangle {}

                            HorizontalLayout {
                                alignment: center;
                                spacing: 8px;
                                StyledButton {
                                    text: "削除";
                                    button-color: #e53e3e;
                                    visible: root.show_edit_buttons;
                                    clicked => {
                                        root.delete_app(idx);
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }

        if root.show_edit_buttons : StyledButton {
            text: "+ 追加";
            button-color: #38a169;
            width: 80px;
            height: 30px;
            x: root.width - self.width - 20px;
            y: 20px;
            clicked => {
                root.add_app_clicked();
            }
        }
    }

    if root.toast-text != "" : Rectangle {
        x: (root.width - self.width) / 2;
        y: root.height - self.height - 20px;
        background: #2d3748;
        border-radius: 8px;
        min-width: 200px;
        max-width: root.width - 40px;
        height: toast-layout.preferred-height + 24px;

        toast-ta := TouchArea {
            clicked => { root.toast-close(); }
        }

        toast-layout := HorizontalLayout {
            padding-left: 16px;
            padding-right: 16px;
            padding-top: 10px;
            padding-bottom: 10px;
            spacing: 12px;
            alignment: start;

            Text {
                text: "⚠";
                color: #f6e05e;
                font-size: 14px;
                vertical-alignment: center;
            }
            Text {
                text: root.toast-text;
                color: #ffffff;
                font-size: 13px;
                vertical-alignment: center;
                wrap: word-wrap;
            }
        }
    }
}
